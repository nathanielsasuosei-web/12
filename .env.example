# Production Docker Compose configuration. Copy this file to .env and replace every placeholder.
# For local development, you can run Django without a .env file.
DOMAIN=beats.example.com
SITE_URL=https://beats.example.com
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=beats.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://beats.example.com

# Use a URL-safe password (hex is convenient) because Compose builds DATABASE_URL from it.
POSTGRES_DB=beat_store
POSTGRES_USER=beat_store
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password

# Use a live Paystack key for production. Mock checkout is only available with DEBUG=1.
PAYSTACK_SECRET_KEY=
PAYMENT_CURRENCY=GHS
PAYMENT_CHANNELS=mobile_money,bank

# SMTP is required for buyer receipts and producer sale notifications.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL="12 Beats <hello@beats.example.com>"
PRODUCER_EMAIL=producer@beats.example.com
