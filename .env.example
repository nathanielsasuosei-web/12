# Copy this file to .env and fill in the values. Never commit .env.

# --- Django -----------------------------------------------------------------
# Set to 1 only for local development. Production must use 0.
DJANGO_DEBUG=0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=beats.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://beats.example.com

# --- Site -------------------------------------------------------------------
SITE_NAME=Beat Store
SITE_DOMAIN=beats.example.com
SITE_URL=https://beats.example.com
# Receives sale notifications and contact form messages.
PRODUCER_EMAIL=producer@example.com
MAX_DOWNLOADS_PER_ORDER=5

# --- Payments (Paystack: mobile money and bank in Ghana) -----------------------
# Use "paystack" in production. "mock" is a development-only test checkout.
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Checkout channels shown to buyers.
PAYSTACK_CHANNELS=mobile_money,bank

# --- Email (SMTP) -------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=hello@example.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Beat Store <hello@example.com>

# --- Optional -----------------------------------------------------------------
# SQLITE_PATH=/app/data/db.sqlite3
# MEDIA_ROOT=/app/media
# PRIVATE_MEDIA_ROOT=/app/private_media
