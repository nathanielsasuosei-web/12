# Copy to .env (or export these). All are optional for local development.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com
SITE_URL=https://yourdomain.com
SITE_NAME=12
# Payments: leave PAYSTACK_SECRET_KEY empty to use test checkout.
PAYSTACK_SECRET_KEY=
PAYMENT_CURRENCY=GHS
PAYMENT_CHANNELS=mobile_money,bank
# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=12 Beats <hello@yourdomain.com>
PRODUCER_EMAIL=producer@yourdomain.com
