{$DOMAIN} {
    encode zstd gzip

    # Public catalog images and videos only. Purchased beat files stay behind
    # the authenticated/tokenized Django download view.
    handle_path /media/covers/* {
        root * /srv/media/covers
        file_server
    }

    handle_path /media/videos/* {
        root * /srv/media/videos
        file_server
    }

    handle /media/* {
        respond "Not found" 404
    }

    handle {
        reverse_proxy web:8000
    }
}
